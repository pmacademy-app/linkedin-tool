# ============================================================
# PRODILY GROWTH ASSISTANT - environment variables
# Copy this file to .env and fill in your values.
# ============================================================

# ---- AI Provider -----------------------------------------------------------
# Supported: nvidia | openai | mock
# Use "mock" for testing without any API key
AI_PROVIDER=nvidia

# NVIDIA NIM (default provider -- get key at https://build.nvidia.com)
NVIDIA_API_KEY=
# Model is always read from env -- change here to switch without code changes
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: use OpenAI directly
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- Discovery Provider ----------------------------------------------------
# Supported: firecrawl (default) | serper | mock
# Use "mock" for testing without any API key (reads data/fixtures/)
SEARCH_PROVIDER=firecrawl

# Firecrawl API key -- https://firecrawl.dev (free tier available)
FIRECRAWL_API_KEY=

# Optional: Serper as secondary discovery provider
# SEARCH_PROVIDER=serper
# SEARCH_API_KEY=

# ---- LinkedIn OAuth (for API comment publishing) ---------------------------
# Optional: only needed for automatic comment publishing via LinkedIn API.
# If not set, comments fall back to clipboard + manual submit.
#
# Setup:
#   1. Go to https://developer.linkedin.com/
#   2. Create an app
#   3. Add "Share on LinkedIn" product (grants w_member_social scope)
#   4. Set the redirect URI below in your app's OAuth 2.0 settings
#
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8899/oauth/linkedin/callback
# Port for the local OAuth callback server (must match LINKEDIN_REDIRECT_URI)
LINKEDIN_CALLBACK_PORT=8899
# LinkedIn API version in YYYYMM format
LINKEDIN_API_VERSION=202506
# Member person URN (urn:li:person:<id>) required as actor for comment publishing.
# Auto-detected if your LinkedIn Developer app has OpenID Connect enabled;
# otherwise set manually here if using only 'Share on LinkedIn' (w_member_social).
LINKEDIN_PERSON_URN=

# ---- Limits ----------------------------------------------------------------
MAX_PEOPLE=30
MAX_POSTS=10